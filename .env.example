# Namuna. Haqiqiy qiymatlar repoga qo'yilmaydi (.env rejimi 0600). To'liq ro'yxat: docs/TZ/15-deploy.md 15.5.
# Dev'da hammasi standart qiymat bilan ishlaydi (backend/config/settings/dev.py); bu fayl prod uchun.

DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=            # 50+ belgi, tasodifiy
ALLOWED_HOSTS=nazoratchi.example.uz
CSRF_TRUSTED_ORIGINS=https://nazoratchi.example.uz

DB_NAME=nazoratchi
DB_USER=nazoratchi
DB_PASSWORD=           # maxfiy
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/0
NAZORATCHI_MASTER_KEY= # base64, 32 bayt (maxfiy maydonlarni shifrlash)
LOG_LEVEL=INFO

# --- Compose / tarqatish ---
NAZORATCHI_VERSION=1.0.0          # image tegi
GHCR_OWNER=                       # ghcr.io/<owner>/nazoratchi-*
AGENT_DIST_HOST_DIR=./agent-dist  # agent binarlari, SHA256SUMS, SHA256SUMS.minisig (release artefaktlari)
PUBLIC_URL=https://nazoratchi.example.uz
MINISIGN_PUBKEY=                  # agent imzosi ochiq kaliti (base64 qatori, .pub faylning 2-qatori)

# --- O'zini kuzatish (S7) ---
WATCHDOG_URL=                     # https://watchdog.example.uz/ping/<id>  (https majburiy)
METRICS_TOKEN=                    # bo'sh = /metrics faqat loopback'dan
NAZORATCHI_BACKUP_AGE_PUBKEY=     # age1... (maxfiy kalit parol menejerida, serverda YO'Q)
TELEGRAM_WEBHOOK_SECRET=          # [A-Za-z0-9_-], 32+ belgi; bo'sh = tugmalar webhook'i o'chiq
