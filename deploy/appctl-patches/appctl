#!/usr/bin/env bash
# appctl — /opt/applications/projects ostidagi docker-compose loyihalarini boshqarish.
#
#   appctl list [--json]
#   appctl up|down|restart|ps <loyiha>
#   appctl logs <loyiha> [servis]
#   appctl deploy <loyiha>
#   appctl backup <loyiha>|all
#   appctl restore <loyiha> <fayl.sql.gz> --yes
#   appctl nginx            # nginx -t && reload
#   appctl status [--json]
#   appctl heartbeat [ok|fail] [xabar]   # Nazoratchi heartbeat'ini qo'lda sinash
#
# Har loyiha papkasida ixtiyoriy `.appctl` fayl bo'lishi mumkin (bash sintaksisi):
#   DB_SERVICE=db            # compose'dagi postgres servisi (backup/restore uchun)
#   DB_USER=nazar
#   DB_NAME=nazar
#   PROJECT_NAME=nazar       # faqat compose loyiha nomi standartdan farq qilsa
#   COMPOSE_EXTRA=docker-compose.server.yml   # serverga xos override (portlar va h.k.)
#   HEALTH_URL=http://127.0.0.1:8020/healthz/
#   HEALTH_CURL_OPTS='-H Host:nazar.avlo.ai -H X-Forwarded-Proto:https'
#   BACKUP_PATHS="/var/lib/docker/volumes/x_media/_data"   # haftalik tar.gz
#
# Global sozlamalar: /opt/applications/appctl.conf (OFFSITE, KEEP_DAILY, KEEP_WEEKLY).
# Maxfiy: /opt/applications/appctl.secret, rejim 0600 (HEARTBEAT_URL; `appctl heartbeat-set <url>`).
set -euo pipefail

BASE="${APPCTL_BASE:-/opt/applications}"
PROJECTS="$BASE/projects"
BACKUPS="$BASE/backups"
OFFSITE=""
HEARTBEAT_URL=""        # Nazoratchi heartbeat (https://<core>/hb/<TOKEN>); appctl.secret da
HEARTBEAT_TIMEOUT=10    # soniya; heartbeat zaxirani hech qachon uzoq kutdirmasligi kerak
KEEP_DAILY=7
KEEP_WEEKLY=5
LETSENCRYPT_LIVE="${APPCTL_LETSENCRYPT:-/etc/letsencrypt/live}"   # faqat `status --json` o'qiydi
# shellcheck disable=SC1091
[ -f "$BASE/appctl.conf" ] && . "$BASE/appctl.conf"
# Token URL ichida bo'lgani uchun alohida 0600 faylda (appctl.conf ni Nazoratchi agenti o'qiydi).
# shellcheck disable=SC1091
[ -f "$BASE/appctl.secret" ] && . "$BASE/appctl.secret"

JSON_MODE=0   # `list --json` / `status --json` da 1: xatolar stdout'ga {"schema":1,"error":...} sifatida ham chiqadi
die() {
  if [ "$JSON_MODE" = 1 ]; then printf '{"schema":1,"error":"%s"}\n' "$(json_escape "$*")"; fi
  echo "xato: $*" >&2; exit 1
}

# --- Nazoratchi: mashinada o'qiladigan zaxira holati (state.json, _run.json) -----------------------
# Sxema: TZ 10.3. Ikkala fayl atomik yoziladi (.tmp -> mv). Yozish xatosi zaxirani HECH QACHON
# buzmaydi: ogohlantirish chiqadi, qolgani davom etadi (R-109).
now_utc() { date -u +%FT%TZ; }

# json_escape <matn> — bir qatorli JSON satr qiymati (qo'shtirnoqsiz): faqat bosma ASCII qoladi,
# maks. 300 belgi, maxfiy qiymatlar (token/secret/password/authorization) yopiladi.
json_escape() {
  local s
  s="$(printf '%s' "$1" | LC_ALL=C tr -c '\040-\176' ' ' \
      | sed -E 's/((token|secret|password|authorization)[A-Za-z_]*[[:space:]]*[=:][[:space:]]*((bearer|basic)[[:space:]]+)?)[^[:space:]]+/\1***/Ig')"
  s="${s:0:300}"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  printf '%s' "$s"
}

# step_json <status> <fayl> <hajm> <xato> — daily/weekly_files bloki
step_json() {
  local file=null err=null
  [ -n "${2:-}" ] && file="\"$(json_escape "$2")\""
  [ -n "${4:-}" ] && err="\"$(json_escape "$4")\""
  printf '{"status":"%s","file":%s,"size_bytes":%s,"error":%s}' "$1" "$file" "${3:-0}" "$err"
}

# atomic_write <yo'l> — stdin dan yo'lga atomik yozadi; muvaffaqiyatsiz bo'lsa 1 qaytaradi.
atomic_write() {
  cat > "$1.tmp" && chmod 0644 "$1.tmp" && mv "$1.tmp" "$1"
}

# state_write <loyiha> <status> <boshlangan> <boshlangan_epoch> <daily_json> <weekly_json>
state_write() {
  local fin dur host
  fin="$(now_utc)"
  dur=$(( $(date +%s) - $4 ))
  host="$(hostname 2>/dev/null || echo unknown)"
  printf '{"schema":1,"project":"%s","host":"%s","status":"%s","started_at":"%s","finished_at":"%s","duration_s":%s,"daily":%s,"weekly_files":%s}\n' \
    "$(json_escape "$1")" "$(json_escape "$host")" "$2" "$3" "$fin" "$dur" "$5" "$6" \
    | atomic_write "$BACKUPS/$1/state.json" 2>/dev/null \
    || echo "[$1] ogohlantirish: state.json yozilmadi (zaxira ta'sirlanmadi)" >&2
  return 0
}

# run_write <run_id> <boshlangan> <loyihalar_json> <offsite_json>
run_write() {
  local host
  host="$(hostname 2>/dev/null || echo unknown)"
  printf '{"schema":1,"host":"%s","run_id":"%s","started_at":"%s","finished_at":"%s","projects":[%s],"offsite":%s}\n' \
    "$(json_escape "$host")" "$1" "$2" "$(now_utc)" "$3" "$4" \
    | atomic_write "$BACKUPS/_run.json" 2>/dev/null \
    || echo "ogohlantirish: _run.json yozilmadi (zaxira ta'sirlanmadi)" >&2
  return 0
}

# --- Nazoratchi heartbeat (TZ 9.14, 10.3.5) -------------------------------------------------------
# urlencode <matn> — baytlar bo'yicha (LC_ALL=C) foiz-kodlash.
urlencode() {
  local LC_ALL=C s="$1" out="" c i
  for ((i = 0; i < ${#s}; i++)); do
    c="${s:i:1}"
    case "$c" in
      [a-zA-Z0-9.~_-]) out+="$c" ;;
      *) out+="$(printf '%%%02X' "'$c")" ;;
    esac
  done
  printf '%s' "$out"
}

HB_RC=0        # oxirgi heartbeat_send natijasi: 0 yuborildi, 2 sozlanmagan, boshqa — curl kodi
HB_PENDING=0   # 1: `backup all` boshlandi, yakuniy heartbeat hali yuborilmadi (EXIT tuzog'i uchun)
HB_START=0

# heartbeat_send <ok|fail> [xabar] [davomiylik_s] — HECH QACHON xato qaytarmaydi (R-109): zaxira
# natijasi va chiqish kodi heartbeat'ga bog'liq emas. Xatolarda URL (token) chop etilmaydi.
heartbeat_send() {
  local url="$HEARTBEAT_URL" sep="?" query err rc=0
  HB_RC=2
  [ -n "$url" ] || return 0
  if ! command -v curl >/dev/null 2>&1; then
    echo "heartbeat yuborilmadi: curl o'rnatilmagan" >&2; HB_RC=127; return 0
  fi
  case "$url" in *\?*) sep="&" ;; esac
  query="status=$1"
  if [ -n "${3:-}" ]; then query="$query&duration=$3"; fi
  if [ -n "${2:-}" ]; then query="$query&msg=$(urlencode "${2:0:200}")"; fi
  err="$(curl -fsS --connect-timeout 5 -m "$HEARTBEAT_TIMEOUT" -o /dev/null "$url$sep$query" 2>&1)" || rc=$?
  HB_RC=$rc
  if [ "$rc" -ne 0 ]; then
    err="${err//"$url"/<heartbeat-url>}"
    echo "heartbeat yuborilmadi (curl $rc): ${err:0:200}" >&2
  fi
  return 0
}

# `backup all` kutilmagan to'xtasa (masalan, buzuq .appctl die qilsa) jimlik o'rniga "fail" yuboriladi.
hb_on_exit() {
  local rc=$?
  if [ "$HB_PENDING" = 1 ]; then
    HB_PENDING=0
    heartbeat_send fail "appctl backup all to'xtatildi (kod $rc)" "$(( $(date +%s) - HB_START ))"
  fi
  return "$rc"
}

cmd_heartbeat() {
  local status="${1:-ok}" msg="${2:-}"
  case "$status" in ok | fail) ;; *) die "heartbeat: holat ok yoki fail bo'lishi kerak" ;; esac
  [ -n "$HEARTBEAT_URL" ] || die "HEARTBEAT_URL sozlanmagan ($BASE/appctl.secret; appctl heartbeat-set <url>)"
  heartbeat_send "$status" "$msg"
  [ "$HB_RC" -eq 0 ] || exit 1
  echo "heartbeat yuborildi: $status"
}

# heartbeat-set <url> — URL ni appctl.secret ga (rejim 0600) yozadi. Fayl bash tomonidan o'qilgani uchun
# URL qat'iy tekshiriladi (qo'shtirnoq, bo'shliq, $, `, \ taqiqlangan).
cmd_heartbeat_set() {
  local url="${1:-}" f="$BASE/appctl.secret" re
  re='^https://[A-Za-z0-9._~:/?&=%+-]+$'
  [[ "$url" =~ $re ]] || die "heartbeat-set: URL https://... bo'lishi va faqat xavfsiz belgilardan iborat bo'lishi kerak"
  mkdir -p "$BASE"
  (
    umask 077
    { grep -v '^HEARTBEAT_URL=' "$f" 2>/dev/null || true; printf "HEARTBEAT_URL='%s'\n" "$url"; } > "$f.tmp"
    chmod 0600 "$f.tmp"
    mv "$f.tmp" "$f"
  )
  echo "heartbeat sozlandi: $f (rejim 0600)"
}

compose_file() {
  local f
  for f in docker-compose.prod.yml compose.prod.yml docker-compose.yml compose.yml; do
    if [ -f "$1/$f" ]; then echo "$f"; return 0; fi
  done
  return 1
}

# proj_load <nom> — DIR, FILE va loyihaning .appctl o'zgaruvchilarini o'rnatadi.
proj_load() {
  DIR="$PROJECTS/$1"
  [ -d "$DIR" ] || die "loyiha topilmadi: $1 ($DIR)"
  FILE="$(compose_file "$DIR")" || die "$1: compose fayl yo'q"
  PROJECT_NAME=""; DB_SERVICE=""; DB_USER=""; DB_NAME=""
  HEALTH_URL=""; HEALTH_CURL_OPTS=""; BACKUP_PATHS=""; COMPOSE_EXTRA=""
  if [ -f "$DIR/.appctl" ]; then
    # JSON rejimida buzuq .appctl bash'ni jimgina (kod 2) to'xtatmasligi, xato JSON'i chiqishi uchun.
    if [ "$JSON_MODE" = 1 ] && ! bash -n "$DIR/.appctl" 2>/dev/null; then
      die "$1: .appctl sintaksis xatosi"
    fi
    # `|| return 3`: buzuq .appctl `backup all` (|| kontekstida set -e ishlamaydi) ichida jimgina "ok" bo'lib
    # qolmasligi uchun; backup_one buni loyiha darajasidagi xato (fail) deb qayd etadi.
    # shellcheck disable=SC1091
    . "$DIR/.appctl" || return 3
  fi
  return 0
}

dc() {
  ( cd "$DIR" && docker compose ${PROJECT_NAME:+-p "$PROJECT_NAME"} -f "$FILE" ${COMPOSE_EXTRA:+-f "$COMPOSE_EXTRA"} "$@" )
}

need() { [ $# -ge 1 ] && [ -n "$1" ] || die "loyiha nomi kerak (appctl list)"; }

# proj_counts — joriy loyiha (proj_load dan keyin) uchun RUNNING, TOTAL, STATE ni o'rnatadi.
# STATE: running | partial | stopped | unknown (docker javob bermasa).
proj_counts() {
  local ids run_ids
  RUNNING=0; TOTAL=0; STATE=unknown
  ids="$(dc ps -a -q 2>/dev/null)" || return 0
  run_ids="$(dc ps --status running -q 2>/dev/null)" || return 0
  TOTAL="$(printf '%s\n' "$ids" | grep -c . || true)"
  RUNNING="$(printf '%s\n' "$run_ids" | grep -c . || true)"
  # stopped: hech narsa ishlamayapti (konteyner yo'q yoki hammasi to'xtagan); partial: bir qismi ishlayapti.
  # (Inson rejimidagi `list` 0/N ni "qisman" deb ko'rsatadi; JSON da ogohlantirish mantig'i uchun farqlanadi.)
  if [ "$RUNNING" -eq 0 ]; then STATE=stopped
  elif [ "$RUNNING" -eq "$TOTAL" ]; then STATE=running
  else STATE=partial; fi
}

# jstr <matn> — JSON satr yoki null (bo'sh bo'lsa). Qiymat json_escape orqali: maxfiy qismlar yopiladi.
jstr() { if [ -n "${1:-}" ]; then printf '"%s"' "$(json_escape "$1")"; else printf 'null'; fi; }

# list_json — `appctl list --json` (TZ 18.1.1). Faqat stdout'ga JSON; tashxis stderr'ga.
# json_mode_on — kutilmagan xato bo'lsa ham (masalan, buzuq .appctl) stdout'ga xato JSON'i chiqadi, kod 1.
json_mode_on() {
  JSON_MODE=1
  set -E
  trap 'printf "{\"schema\":1,\"error\":\"buyruq muvaffaqiyatsiz (qator %s)\"}\n" "$LINENO"; exit 1' ERR
}

list_json() {
  json_mode_on
  local d n items="" sep="" db paths="" psep="" w
  local -a words
  for d in "$PROJECTS"/*/; do
    [ -d "$d" ] || continue
    n="$(basename "$d")"
    compose_file "${d%/}" >/dev/null 2>&1 || continue
    proj_load "$n"
    proj_counts
    db=null
    if [ -n "$DB_SERVICE" ]; then
      db="$(printf '{"service":%s,"user":%s,"name":%s}' "$(jstr "$DB_SERVICE")" "$(jstr "$DB_USER")" "$(jstr "$DB_NAME")")"
    fi
    paths=""; psep=""
    read -r -a words <<< "$BACKUP_PATHS" || true
    for w in "${words[@]}"; do paths="$paths$psep$(jstr "$w")"; psep=","; done
    items="$items$sep$(printf '{"name":%s,"compose_file":%s,"compose_extra":%s,"state":"%s","running":%s,"total":%s,"health_url":%s,"db":%s,"backup_paths":[%s]}' \
      "$(jstr "$n")" "$(jstr "$FILE")" "$(jstr "$COMPOSE_EXTRA")" "$STATE" "$RUNNING" "$TOTAL" "$(jstr "$HEALTH_URL")" "$db" "$paths")"
    sep=","
  done
  printf '{"schema":1,"host":%s,"generated_at":"%s","projects":[%s]}\n' \
    "$(jstr "$(hostname 2>/dev/null || echo unknown)")" "$(now_utc)" "$items"
}

cmd_list() {
  case "${1:-}" in
    --json) list_json; return 0 ;;
    "") ;;
    *) die "list: noma'lum bayroq: $1 (appctl list [--json])" ;;
  esac
  printf '%-24s %-9s %s\n' LOYIHA HOLAT KONTEYNER
  local d n running total state
  for d in "$PROJECTS"/*/; do
    [ -d "$d" ] || continue
    n="$(basename "$d")"
    compose_file "${d%/}" >/dev/null 2>&1 || continue
    proj_load "$n"
    running="$(dc ps --status running -q 2>/dev/null | wc -l)"
    total="$(dc ps -a -q 2>/dev/null | wc -l)"
    if [ "$total" -eq 0 ]; then state="o'chiq"
    elif [ "$running" -eq "$total" ]; then state="ishlayapti"
    else state="qisman"; fi
    printf '%-24s %-9s %s/%s\n' "$n" "$state" "$running" "$total"
  done
}

health_check() {
  [ -n "$HEALTH_URL" ] || return 0
  local i code
  echo "→ health check: $HEALTH_URL"
  for i in $(seq 1 30); do
    # shellcheck disable=SC2086
    code="$(curl -sL -o /dev/null -w '%{http_code}' --max-time 5 $HEALTH_CURL_OPTS "$HEALTH_URL" || true)"
    if [ "$code" = "200" ]; then echo "  OK (200)"; return 0; fi
    sleep 2
  done
  echo "  XATO: oxirgi javob $code" >&2
  return 1
}

cmd_deploy() {
  need "${1:-}"; proj_load "$1"
  if [ -d "$DIR/.git" ]; then
    echo "→ git pull"
    git -C "$DIR" pull --ff-only
  fi
  echo "→ build + up"
  dc up -d --build --remove-orphans
  dc ps
  health_check
}

LAST_STATUS=""   # backup_one natijasi (ok|fail); cmd_backup _run.json uchun o'qiydi

backup_one() {
  local out="$BACKUPS/$1" ts f errf err
  local started started_epoch status=ok daily_json=null weekly_json=null
  started="$(now_utc)"; started_epoch="$(date +%s)"
  LAST_STATUS=fail
  if ! proj_load "$1"; then
    # Asl skript buzuq .appctl bilan davom etib, dump o'tkazib yuborilgan loyihani "ok" deb qoldirardi.
    echo "[$1] XATO: .appctl o'qilmadi (sintaksis xatosi?); loyiha o'tkazib yuborildi" >&2
    mkdir -p "$out" 2>/dev/null || true
    state_write "$1" fail "$started" "$started_epoch" "$(step_json fail "" 0 ".appctl o'qilmadi (sintaksis xatosi?)")" null
    return 1
  fi
  ts="$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$out/daily" "$out/weekly"
  errf="$(mktemp 2>/dev/null)" || errf="$out/.stderr.$$"   # xato matni; oxirida o'chiriladi

  if [ -n "$DB_SERVICE" ]; then
    f="$out/daily/$1-$ts.sql.gz"
    echo "[$1] pg_dump → $f"
    if dc exec -T "$DB_SERVICE" pg_dump -U "$DB_USER" -d "$DB_NAME" 2>"$errf" | gzip > "$f.tmp" \
       && [ "$(stat -c %s "$f.tmp")" -gt 1024 ]; then
      mv "$f.tmp" "$f"
      [ "$(date +%u)" = "7" ] && cp "$f" "$out/weekly/"
      daily_json="$(step_json ok "$(basename "$f")" "$(stat -c %s "$f")" "")"
    else
      rm -f "$f.tmp"
      err="$(head -n 3 "$errf" 2>/dev/null || true)"
      [ -n "$err" ] || err="dump bo'sh yoki 1024 baytdan kichik"
      echo "[$1] XATO: dump muvaffaqiyatsiz" >&2
      if [ -s "$errf" ]; then cat "$errf" >&2; fi
      state_write "$1" fail "$started" "$started_epoch" "$(step_json fail "" 0 "$err")" null
      rm -f "$errf"
      return 1
    fi
  else
    echo "[$1] DB_SERVICE yo'q — baza dumpi o'tkazib yuborildi"
  fi

  if [ -n "$BACKUP_PATHS" ] && [ "$(date +%u)" = "7" ]; then
    f="$out/weekly/$1-files-$ts.tar.gz"
    echo "[$1] fayllar → $f"
    # shellcheck disable=SC2086
    if tar -czf "$f" $BACKUP_PATHS 2>"$errf"; then
      weekly_json="$(step_json ok "$(basename "$f")" "$(stat -c %s "$f")" "")"
    else
      rm -f "$f"
      err="$(head -n 3 "$errf" 2>/dev/null || true)"
      [ -n "$err" ] || err="tar muvaffaqiyatsiz"
      echo "[$1] XATO: fayllar zaxirasi muvaffaqiyatsiz" >&2
      weekly_json="$(step_json fail "" 0 "$err")"
      status=fail
    fi
    if [ -s "$errf" ]; then cat "$errf" >&2; fi
  fi
  rm -f "$errf"

  find "$out/daily" -type f -mtime +"$KEEP_DAILY" -delete
  find "$out/weekly" -type f -mtime +"$((KEEP_WEEKLY * 7))" -delete

  state_write "$1" "$status" "$started" "$started_epoch" "$daily_json" "$weekly_json"
  LAST_STATUS="$status"
  [ "$status" = ok ]
}

cmd_backup() {
  need "${1:-}"
  local d n failed=0 run_id run_started run_epoch projects_json="" sep="" failed_names="" dur
  local offsite_json='{"configured":false,"status":null,"target_host":null,"exit_code":null,"finished_at":null,"bytes_sent":null}'
  local rsync_out rc ostatus bytes host
  run_id="$(date -u +%Y%m%d-%H%M%S)"; run_started="$(now_utc)"; run_epoch="$(date +%s)"
  if [ "$1" = "all" ] && [ -n "$HEARTBEAT_URL" ]; then
    HB_PENDING=1; HB_START="$run_epoch"
    # Signal bilan to'xtatilsa bash EXIT tuzog'ini o'zi ishga tushiradi, lekin `$?` 0 bo'lib qoladi
    # (noto'g'ri "kod 0"); shuning uchun signal tuzoqlari to'g'ri kodni (128+signal) beradi.
    trap 'exit 143' TERM; trap 'exit 130' INT; trap 'exit 129' HUP
    trap hb_on_exit EXIT
  fi
  if [ "$1" = "all" ]; then
    for d in "$PROJECTS"/*/; do
      n="$(basename "$d")"
      compose_file "${d%/}" >/dev/null 2>&1 || continue
      backup_one "$n" || { failed=1; failed_names="$failed_names${failed_names:+,}$n"; }
      projects_json="$projects_json$sep{\"name\":\"$(json_escape "$n")\",\"status\":\"$LAST_STATUS\"}"
      sep=","
    done
  else
    backup_one "$1" || failed=1
  fi
  if [ -n "$OFFSITE" ]; then
    echo "→ offsite: $OFFSITE"
    rsync_out="$(mktemp 2>/dev/null)" || rsync_out="$BACKUPS/.rsync.$$"
    rc=0
    rsync -a --stats -e "ssh -o BatchMode=yes" "$BACKUPS/" "$OFFSITE/" >"$rsync_out" 2>&1 || rc=$?
    cat "$rsync_out"
    ostatus=ok
    if [ "$rc" -ne 0 ]; then ostatus=fail; failed=1; failed_names="$failed_names${failed_names:+,}offsite"; fi
    bytes="$(sed -n 's/^Total bytes sent: *//p' "$rsync_out" | head -n 1 | tr -dc '0-9')"
    [ -n "$bytes" ] || bytes=null
    host="${OFFSITE#*@}"; host="${host%%:*}"
    offsite_json="$(printf '{"configured":true,"status":"%s","target_host":"%s","exit_code":%s,"finished_at":"%s","bytes_sent":%s}' \
      "$ostatus" "$(json_escape "$host")" "$rc" "$(now_utc)" "$bytes")"
    rm -f "$rsync_out"
  fi
  # _run.json faqat "all" uchun: u barcha loyihalarni qamrab olgan umumiy ishga tushirishni bildiradi.
  if [ "$1" = "all" ]; then
    run_write "$run_id" "$run_started" "$projects_json" "$offsite_json"
    # Heartbeat (TZ 10.3.5): state.json dan mustaqil ikkinchi signal. Cron umuman ishlamasa yoki appctl
    # yiqilsa signal kelmaydi (AL-047); xato bo'lsa darhol "fail" (AL-048).
    HB_PENDING=0
    dur=$(( $(date +%s) - run_epoch ))
    if [ "$failed" -eq 0 ]; then heartbeat_send ok "" "$dur"; else heartbeat_send fail "fail: $failed_names" "$dur"; fi
  fi
  return "$failed"
}

cmd_restore() {
  need "${1:-}"; proj_load "$1"
  local file="${2:-}" yes="${3:-}"
  [ -f "$file" ] || die "dump fayl topilmadi: $file"
  [ -n "$DB_SERVICE" ] || die "$1: .appctl da DB_SERVICE yo'q"
  [ "$yes" = "--yes" ] || die "bu '$DB_NAME' bazasini O'CHIRIB qayta yaratadi. Tasdiqlash: appctl restore $1 $file --yes"
  echo "→ baza bilan ishlamaydigan servislarni to'xtatish"
  dc up -d "$DB_SERVICE"
  # shellcheck disable=SC2046
  dc stop $(dc config --services | grep -vx "$DB_SERVICE") || true
  echo "→ bazani qayta yaratish"
  dc exec -T "$DB_SERVICE" psql -U "$DB_USER" -d postgres \
    -c "DROP DATABASE IF EXISTS \"$DB_NAME\" WITH (FORCE)" \
    -c "CREATE DATABASE \"$DB_NAME\" OWNER \"$DB_USER\""
  echo "→ dump yuklanmoqda"
  gunzip -c "$file" | dc exec -T "$DB_SERVICE" psql -U "$DB_USER" -d "$DB_NAME" -v ON_ERROR_STOP=1 -q
  echo "→ servislarni ishga tushirish"
  dc up -d
  health_check
}

cmd_nginx() { nginx -t && systemctl reload nginx && echo "nginx qayta yuklandi"; }

isnum() { [[ "${1:-}" =~ ^[0-9]+$ ]]; }

# status_json — `appctl status --json` (TZ 18.1.2). Olib bo'lmagan bo'lim: disk/memory/containers = null
# (docker, df yoki free ishlamasa); sertifikat va zaxira bo'limlari bo'sh massiv bo'lishi mumkin.
status_json() {
  json_mode_on
  local disk_total="" disk_used="" disk_pct="" mem_total="" mem_avail=""
  local disk_json=null mem_json=null containers_json=null
  local certs="" csep="" backups="" bsep="" cont="" ksep="" lines name st running health
  local c exp na days f p last cnt_d cnt_w last_json

  read -r disk_total disk_used disk_pct < <(df -P -B1 / 2>/dev/null | awk 'NR==2 {p=$(NF-1); gsub("%","",p); print $(NF-4), $(NF-3), p}') || true
  if isnum "$disk_total" && isnum "$disk_used" && isnum "$disk_pct"; then
    disk_json="$(printf '{"mount":"/","total_bytes":%s,"used_bytes":%s,"used_percent":%s}' "$disk_total" "$disk_used" "$disk_pct")"
  fi
  read -r mem_total mem_avail < <(free -b 2>/dev/null | awk '/^Mem:/ {print $2, $7}') || true
  if isnum "$mem_total" && isnum "$mem_avail"; then
    mem_json="$(printf '{"total_bytes":%s,"used_bytes":%s,"available_bytes":%s}' "$mem_total" "$((mem_total - mem_avail))" "$mem_avail")"
  fi

  if lines="$(docker ps -a --format '{{.Names}}\t{{.Status}}' 2>/dev/null)"; then
    while IFS=$'\t' read -r name st; do
      [ -n "$name" ] || continue
      case "$st" in Up*) running=true ;; *) running=false ;; esac
      case "$st" in
        *"(unhealthy)"*) health='"unhealthy"' ;;
        *"(healthy)"*) health='"healthy"' ;;
        *"(health: starting)"*) health='"starting"' ;;
        *) health=null ;;
      esac
      cont="$cont$ksep$(printf '{"name":%s,"status":%s,"running":%s,"health":%s}' "$(jstr "$name")" "$(jstr "$st")" "$running" "$health")"
      ksep=","
    done <<< "$lines"
    containers_json="[$cont]"
  fi

  for c in "$LETSENCRYPT_LIVE"/*/cert.pem; do
    [ -f "$c" ] || continue
    if exp="$(openssl x509 -enddate -noout -in "$c" 2>/dev/null | cut -d= -f2)" && [ -n "$exp" ] \
       && na="$(date -u -d "$exp" +%FT%TZ 2>/dev/null)"; then
      days=$(( ( $(date -d "$exp" +%s) - $(date +%s) ) / 86400 ))
      certs="$certs$csep$(printf '{"name":%s,"not_after":"%s","days_left":%s}' "$(jstr "$(basename "$(dirname "$c")")")" "$na" "$days")"
      csep=","
    else
      echo "ogohlantirish: sertifikat o'qilmadi: $c" >&2
    fi
  done

  for f in "$BACKUPS"/*/daily; do
    [ -d "$f" ] || continue
    p="$(basename "$(dirname "$f")")"
    # `|| true`: papka (masalan, weekly) yo'q bo'lsa find 1 qaytaradi; pipefail + set -e skriptni to'xtatmasligi kerak.
    last="$(find "$f" -type f -name '*.sql.gz' -printf '%T@\n' 2>/dev/null | sort -n | tail -n 1 || true)"; last="${last%%.*}"
    cnt_d="$(find "$f" -type f -name '*.sql.gz' 2>/dev/null | wc -l || true)"
    cnt_w="$(find "$(dirname "$f")/weekly" -type f -name '*.sql.gz' 2>/dev/null | wc -l || true)"
    last_json=null
    if isnum "$last"; then last_json="\"$(date -u -d "@$last" +%FT%TZ)\""; fi
    backups="$backups$bsep$(printf '{"project":%s,"last_daily_at":%s,"daily_count":%s,"weekly_count":%s}' \
      "$(jstr "$p")" "$last_json" "$((cnt_d))" "$((cnt_w))")"
    bsep=","
  done

  printf '{"schema":1,"host":%s,"generated_at":"%s","disk":%s,"memory":%s,"containers":%s,"certificates":[%s],"backups":[%s]}\n' \
    "$(jstr "$(hostname 2>/dev/null || echo unknown)")" "$(now_utc)" "$disk_json" "$mem_json" "$containers_json" "$certs" "$backups"
}

cmd_status() {
  case "${1:-}" in
    --json) status_json; return 0 ;;
    "") ;;
    *) die "status: noma'lum bayroq: $1 (appctl status [--json])" ;;
  esac
  echo "== Disk";  df -h / | tail -n 1
  echo "== Xotira"; free -h | sed -n 2p
  echo "== Konteynerlar"; docker ps --format 'table {{.Names}}\t{{.Status}}'
  echo "== Sertifikatlar (qolgan kun)"
  local c exp days
  for c in /etc/letsencrypt/live/*/cert.pem; do
    [ -f "$c" ] || continue
    exp="$(openssl x509 -enddate -noout -in "$c" | cut -d= -f2)"
    days=$(( ( $(date -d "$exp" +%s) - $(date +%s) ) / 86400 ))
    printf '  %-34s %4s kun\n' "$(basename "$(dirname "$c")")" "$days"
  done
  echo "== Oxirgi zaxiralar"
  local f
  for f in "$BACKUPS"/*/daily; do
    [ -d "$f" ] || continue
    printf '  %-24s %s\n' "$(basename "$(dirname "$f")")" \
      "$(find "$f" -type f -printf '%TY-%Tm-%Td %TH:%TM\n' | sort | tail -n 1)"
  done
}

usage() { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }

cmd="${1:-}"; [ $# -gt 0 ] && shift || true
case "$cmd" in
  list)    cmd_list "${1:-}" ;;
  up)      need "${1:-}"; proj_load "$1"; dc up -d ;;
  down)    need "${1:-}"; proj_load "$1"; dc down ;;
  restart) need "${1:-}"; proj_load "$1"; dc restart ;;
  ps)      need "${1:-}"; proj_load "$1"; dc ps ;;
  logs)    need "${1:-}"; proj_load "$1"; n="$1"; shift; dc logs -f --tail 100 "$@" ;;
  deploy)  cmd_deploy "${1:-}" ;;
  backup)  cmd_backup "${1:-}" ;;
  restore) cmd_restore "${1:-}" "${2:-}" "${3:-}" ;;
  nginx)   cmd_nginx ;;
  status)  cmd_status "${1:-}" ;;
  heartbeat)     cmd_heartbeat "${1:-}" "${2:-}" ;;
  heartbeat-set) cmd_heartbeat_set "${1:-}" ;;
  *)       usage ;;
esac
