# Host nginx (core), TZ 15.6. Domen almashtiriladi:
#   NAZORATCHI_DOMAIN=nazoratchi.example.uz envsubst '${NAZORATCHI_DOMAIN}' < nazoratchi.conf.template > /etc/nginx/sites-available/nazoratchi.conf
# So'ng: nginx -t && systemctl reload nginx && certbot --nginx -d $NAZORATCHI_DOMAIN  (443 va yo'naltirishni certbot qo'shadi)

limit_req_zone $binary_remote_addr zone=nzr_login:10m rate=10r/m;
limit_req_zone $http_authorization zone=nzr_ingest:10m rate=30r/m;
limit_req_zone $binary_remote_addr zone=nzr_api:10m rate=20r/s;

server {
    server_name ${NAZORATCHI_DOMAIN};
    server_tokens off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;

    client_max_body_size 2m;

    location /ingest/ {
        limit_req zone=nzr_ingest burst=10 nodelay;
        proxy_pass http://127.0.0.1:8040;
        include /etc/nginx/proxy_params;
    }
    location /hb/ {
        limit_req zone=nzr_ingest burst=10 nodelay;
        proxy_pass http://127.0.0.1:8040;
        include /etc/nginx/proxy_params;
    }
    location /api/v1/auth/login {
        limit_req zone=nzr_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:8040;
        include /etc/nginx/proxy_params;
    }
    location /api/ {
        limit_req zone=nzr_api burst=40 nodelay;
        proxy_pass http://127.0.0.1:8040;
        include /etc/nginx/proxy_params;
    }
    # Agent o'rnatuvchi va binarlari; healthz — tashqi tekshiruv uchun
    location ~ ^/(healthz|install\.sh|agent/) {
        proxy_pass http://127.0.0.1:8040;
        include /etc/nginx/proxy_params;
    }
    # Ichki endpointlar tashqariga berilmaydi
    location ~ ^/(metrics|readyz) { return 404; }

    location / {                                   # SPA
        proxy_pass http://127.0.0.1:3040;
        include /etc/nginx/proxy_params;
    }

    listen 80;
}
