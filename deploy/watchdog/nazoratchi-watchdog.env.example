# /etc/nazoratchi-watchdog.env  (rejim 0600, egasi root). Mustaqil bot: core botidan ALOHIDA bo'lishi shart.
WATCHDOG_ID=                      # 16-64 belgi, tasodifiy: openssl rand -hex 24 ; core WATCHDOG_URL ga shu id yoziladi
WATCHDOG_BOT_TOKEN=               # @BotFather bergan alohida bot tokeni
WATCHDOG_CHAT_ID=                 # Telegram chat ID
WATCHDOG_LISTEN=127.0.0.1:8099    # nginx /ping/ ni shunga proksilaydi
WATCHDOG_TIMEOUT_S=300
WATCHDOG_REMIND_S=1800
WATCHDOG_STATE_FILE=/var/lib/nazoratchi-watchdog/state.json
